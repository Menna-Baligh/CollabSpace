						"url": {
							"raw": "{{base_url}}/api/v1/reports/analytics?period=monthly",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "reports", "analytics"],
							"query": [
								{
									"key": "period",
									"value": "monthly",
