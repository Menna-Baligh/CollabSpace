{
  "info": {
    "_postman_id": "collab-meetings-module",
    "name": "08 - Meetings Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "token",    "value": ""}
  ],
  "item": [
    {
      "name": "Meetings",
      "item": [
        {
          "name": "List Meetings",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept",          "value": "application/json"},
              {"key": "Accept-Language", "value": "en"},
              {"key": "Authorization",   "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/meetings?view=week&date=2026-11-24&project_id=&status=",
              "host": ["{{base_url}}"],
              "path": ["api","v1","meetings"],
              "query": [
                {"key": "view",       "value": "week",        "description": "week|month"},
                {"key": "date",       "value": "2026-11-24",  "description": "Reference date YYYY-MM-DD"},
                {"key": "project_id", "value": "",            "description": "Filter by project"},
                {"key": "status",     "value": "",            "description": "scheduled|live|completed|cancelled"},
                {"key": "per_page",   "value": "15"}
              ]
            }
          }
        },
        {
          "name": "Create Meeting",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept",          "value": "application/json"},
              {"key": "Accept-Language", "value": "en"},
              {"key": "Authorization",   "value": "Bearer {{token}}"},
              {"key": "Content-Type",    "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 Kickoff\",\n  \"description\": \"Kick off the fourth quarter planning.\",\n  \"start_time\": \"2026-12-01 10:00:00\",\n  \"end_time\": \"2026-12-01 11:30:00\",\n  \"timezone\": \"UTC\",\n  \"project_id\": null,\n  \"participant_ids\": [2, 3]\n}"
            },
            "url": {"raw": "{{base_url}}/api/v1/meetings", "host": ["{{base_url}}"], "path": ["api","v1","meetings"]}
          }
        },
        {
          "name": "Get Meeting Details",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept",        "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1"]}
          }
        },
        {
          "name": "Update Meeting",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Accept",          "value": "application/json"},
              {"key": "Authorization",   "value": "Bearer {{token}}"},
              {"key": "Content-Type",    "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Q4 Kickoff\",\n  \"end_time\": \"2026-12-01 12:00:00\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/v1/meetings/1", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1"]}
          }
        },
        {
          "name": "Cancel Meeting",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept",        "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/cancel", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","cancel"]}
          }
        },
        {
          "name": "Delete Meeting",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Accept",        "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1"]}
          }
        }
      ]
    },
    {
      "name": "Participants",
      "item": [
        {
          "name": "Invite Participants",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept",          "value": "application/json"},
              {"key": "Authorization",   "value": "Bearer {{token}}"},
              {"key": "Content-Type",    "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"participant_ids\": [2, 3, 4]}"
            },
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/participants", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","participants"]}
          }
        },
        {
          "name": "RSVP (Accept/Decline)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Accept",          "value": "application/json"},
              {"key": "Authorization",   "value": "Bearer {{token}}"},
              {"key": "Content-Type",    "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"accepted\"}"
            },
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/rsvp", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","rsvp"]}
          }
        },
        {
          "name": "Record Attendance (Join)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept",          "value": "application/json"},
              {"key": "Authorization",   "value": "Bearer {{token}}"},
              {"key": "Content-Type",    "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"join\"}"
            },
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/attendance", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","attendance"]}
          }
        },
        {
          "name": "Get Join URL",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept",        "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/join", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","join"]}
          }
        }
      ]
    },
    {
      "name": "Recordings",
      "item": [
        {
          "name": "Upload Recording",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept",        "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "recording",         "type": "file", "src": "/path/to/meeting.mp4"},
                {"key": "duration_seconds",  "value": "3600", "type": "text"}
              ]
            },
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/recordings", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","recordings"]}
          }
        },
        {
          "name": "Download Recording",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept",        "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/recordings/1/download", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","recordings","1","download"]}
          }
        }
      ]
    },
    {
      "name": "Notes & Comments",
      "item": [
        {
          "name": "List Notes",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/notes", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","notes"]}
          }
        },
        {
          "name": "Add Note",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"content\": \"Action item: finalize API docs by Friday.\"}"},
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/notes", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","notes"]}
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/comments?per_page=25", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","comments"]}
          }
        },
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"comment\": \"Great session, really productive!\"}"},
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/comments", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","comments"]}
          }
        },
        {
          "name": "Edit Comment",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"comment\": \"Updated comment text.\"}"},
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/comments/1", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","comments","1"]}
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/comments/1", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","comments","1"]}
          }
        }
      ]
    },
    {
      "name": "AI Transcription & Summary",
      "item": [
        {
          "name": "Request Transcription",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/transcribe", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","transcribe"]}
          }
        },
        {
          "name": "Get Transcript",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/meetings/1/transcript?search=action",
              "host": ["{{base_url}}"],
              "path": ["api","v1","meetings","1","transcript"],
              "query": [{"key": "search", "value": "action", "description": "Search within transcript text"}]
            }
          }
        },
        {
          "name": "Request AI Summary",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/summarize", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","summarize"]}
          }
        },
        {
          "name": "Get AI Summary",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/meetings/1/summary", "host": ["{{base_url}}"], "path": ["api","v1","meetings","1","summary"]}
          },
          "response": [
            {
              "name": "200 OK - Completed",
              "status": "OK",
              "code": 200,
              "body": "{\"data\":{\"id\":1,\"summary\":\"The team reviewed deliverables...\",\"key_points\":[\"API ready by Friday\"],\"action_items\":[{\"task\":\"Write tests\",\"assignee\":\"Backend Lead\",\"due_date\":\"2026-12-01\"}],\"status\":\"completed\"}}"
            }
          ]
        }
      ]
    }
  ]
}
